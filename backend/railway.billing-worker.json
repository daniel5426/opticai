{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "backend/**"
    ]
  },
  "deploy": {
    "startCommand": "python -m workers.billing_worker",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "ipv6EgressEnabled": true
  }
}
