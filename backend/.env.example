APP_ENV=development
# OpticPlus stays disabled until the packaged Windows/ACE pilot is verified.
OPTICPLUS_MIGRATION_ENABLED=0
DATABASE_URL=sqlite:///./opticai.db
PRODUCTION_DATABASE_URL=postgresql://username:password@production-host:5432/database_name
SECRET_KEY=replace-with-a-local-development-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-local-development-encryption-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
CLINIC_TRUST_EXPIRE_DAYS=3650
BACKEND_CORS_ORIGINS=http://localhost:5126,http://127.0.0.1:5126,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://prysm.co.il,https://staging.prysm.co.il

OPENAI_API_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=
SUPABASE_BUCKET=opticai

GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# Prysm website, billing, and transactional email
SITE_URL=https://prysm.co.il
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ESSENTIAL_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_NETWORK_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
# Signup verification is sent by this API, independently of Vercel newsletter email.
RESEND_API_KEY=
# Optional separate campaign account; falls back to RESEND_API_KEY for older setups.
CAMPAIGN_RESEND_API_KEY=
# Optional public origin for campaign links, separate from subscription callbacks.
CAMPAIGN_PUBLIC_URL=
# Opt-in clinic development tunnel; starts/stops with DevDesk and requires cloudflared.
PRYSM_CAMPAIGN_CALLBACKS_ENABLED=false
EMAIL_FROM=Prysm <hello@prysm.co.il>
TERMS_VERSION=2026-08-09
PRIVACY_VERSION=2026-08-09
SUBSCRIPTION_ENFORCEMENT_MODE=off
# Switch only after web checkout is live; false preserves old desktop registration.
WEB_SIGNUP_REQUIRED=false

# Trusted clinic-agent backend only; never expose these settings to Electron renderer code.
AGENTS24_ENABLED=false
AGENTS24_BASE_URL=https://api.agents24.dev
AGENTS24_API_KEY=
AGENTS24_INTEGRATION_ID=prysm
AGENTS24_RUNTIME_TARGET=published
AGENTS24_ARTIFACT_TRANSPORT=relay
AGENTS24_ARTIFACT_SIGNING_SECRET=
AGENTS24_RELAY_CLIENT_ID=
PRYSM_AGENT_DATA_DIR=
AGENTS24_AGENT_ID=
AGENTS24_INSIGHTS_AGENT_ID=
AGENTS24_BRIEF_AGENT_ID=
AGENTS24_DOCUMENT_PIPELINE_ID=
AGENTS24_NATIVE_DOCUMENT_PIPELINE_ID=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=replace-with-webhook-verify-token
FB_APP_ID=
FB_APP_SECRET=

# Staged permanent patient-file contents; explicit ingestion is required.
PRYSM_DOCUMENT_LIBRARY_ENABLED=false
AGENTS24_DOCUMENT_STORE_ID=
AGENTS24_DOCUMENT_SEARCH_AGENT_ID=

# Allpay SaaS billing. Keep disabled until test acceptance and explicit cutover.
ALLPAY_API_LOGIN=
ALLPAY_API_KEY=
ALLPAY_TEST_MODE=true
ALLPAY_LIVE_PAYMENTS_ENABLED=false
BILLING_CHARGING_ENABLED=false
# Immutable existing user IDs only. Empty denies all platform administration.
OWNER_USER_IDS=
# Public HTTPS FastAPI origin receiving provider webhooks (not the website proxy).
API_PUBLIC_URL=http://127.0.0.1:8000

# Supply mapper workflow and managed speech executable (publish the matching resources first).
AGENTS24_SUPPLY_AGENT_ID=
AGENTS24_SPEECH_PIPELINE_ID=

# Phone barcode scanner. Enable only after Alembic 0060 and notification readiness.
SCANNER_ENABLED=false
# Same database as DATABASE_URL; session-mode/direct connection for LISTEN only.
SCANNER_NOTIFY_DATABASE_URL=

# Optional local campaign draft profile: isolated local drafts, never production publication.
PRYSM_CLINIC_CAMPAIGN_DRAFT=false
# Signed manual-top-up callbacks may use the restricted local campaign gateway.
# Production normally uses API_PUBLIC_URL; never point production at a temporary tunnel.
MESSAGING_PAYMENT_PUBLIC_URL=

# Manual messaging top-ups are independent of automatic subscription collection.
MESSAGING_TOPUPS_ENABLED=false
# Dedicated messaging checkout integration; leave both blank for legacy credentials.
MESSAGING_ALLPAY_API_LOGIN=
MESSAGING_ALLPAY_API_KEY=
MESSAGING_ALLPAY_TEST_MODE=true
# Match the integration flow configured in Allpay. Redirect supports localhost/native tests.
MESSAGING_ALLPAY_CHECKOUT_MODE=redirect
