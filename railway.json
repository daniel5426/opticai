{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build:web",
    "watchPatterns": [
      "src/**",
      "public/**",
      "scanner/**",
      "index.html",
      "package.json",
      "package-lock.json",
      "vite.renderer.config.mts",
      "railway.json",
      "scripts/serve-web.mjs",
      "scripts/agent-web-proxy.mjs",
      "railpack.json",
      "config/devdesk-release/**",
      "scripts/devdesk-release-inputs.mjs",
      "config/desktop-runtime/**",
      "scripts/desktop-runtime.mjs"
    ]
  },
  "deploy": {
    "startCommand": "npm run start:web",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
